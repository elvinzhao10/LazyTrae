{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lazyseries-trae-host-status.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "product", "version", "profiles"],
  "properties": {
    "schema_version": { "const": 2 },
    "contract_version": { "const": "2.0.0" },
    "product": { "const": "LazyTrae" },
    "version": { "const": "1.2.0" },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "host_label", "client_context", "execution_context", "contract_version", "evidence_fingerprint", "host_fingerprint", "capability_matrix", "package_assets", "generated_assets", "config", "probe", "discovery", "registration", "session", "mcp", "observation", "support", "package_readiness", "host_readiness"],
        "properties": {
          "host": { "enum": ["trae-cli", "trae-ide", "trae-work"] },
          "host_label": { "enum": ["TraeCode CLI", "TraeCode", "TraeWork"] },
          "client_context": { "enum": ["terminal", "desktop", "unspecified"] },
          "execution_context": { "enum": ["local", "unspecified"] },
          "contract_version": { "const": "2.0.0" },
          "evidence_fingerprint": { "$ref": "#/$defs/digest" },
          "host_fingerprint": { "$ref": "#/$defs/digest" },
          "capability_matrix": { "$ref": "#/$defs/capability_matrix" },
          "package_assets": { "type": "object" },
          "generated_assets": { "type": "object" },
          "config": { "$ref": "#/$defs/evidence" },
          "probe": { "$ref": "#/$defs/evidence" },
          "discovery": { "$ref": "#/$defs/evidence" },
          "registration": { "$ref": "#/$defs/evidence" },
          "session": { "$ref": "#/$defs/evidence" },
          "mcp": { "$ref": "#/$defs/evidence" },
          "observation": { "$ref": "#/$defs/evidence" },
          "support": { "type": "string" },
          "package_readiness": { "enum": ["ready", "failed"] },
          "host_readiness": { "enum": ["observed", "pending"] }
        },
        "allOf": [
          {
            "if": { "properties": { "host": { "const": "trae-cli" } }, "required": ["host"] },
            "then": { "properties": { "host_label": { "const": "TraeCode CLI" }, "client_context": { "const": "terminal" }, "execution_context": { "const": "local" } } }
          },
          {
            "if": { "properties": { "host": { "const": "trae-ide" } }, "required": ["host"] },
            "then": { "properties": { "host_label": { "const": "TraeCode" }, "client_context": { "const": "desktop" }, "execution_context": { "const": "local" } } }
          },
          {
            "if": { "properties": { "host": { "const": "trae-work" } }, "required": ["host"] },
            "then": { "properties": { "host_label": { "const": "TraeWork" }, "client_context": { "const": "unspecified" }, "execution_context": { "const": "unspecified" } } }
          }
        ]
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["status", "detail"], "properties": { "status": { "enum": ["ready", "missing", "conflict", "pending", "observed"] }, "detail": { "type": "string" } } },
    "capability_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract_version", "host", "client", "execution", "descriptor_sha256", "capabilities", "matrix_sha256"],
      "properties": {
        "schema_version": { "const": 1 },
        "contract_version": { "const": "1.2.0" },
        "host": { "enum": ["trae-cli", "trae-ide", "trae-work"] },
        "client": { "enum": ["terminal", "desktop", "web", "mobile", "unspecified"] },
        "execution": { "enum": ["local", "cloud", "unspecified"] },
        "descriptor_sha256": { "$ref": "#/$defs/digest" },
        "matrix_sha256": { "$ref": "#/$defs/digest" },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability_id", "status", "evidence"],
            "properties": {
              "capability_id": { "type": "string" },
              "status": { "enum": ["host-executed", "host-observed", "descriptor-only", "unavailable"] },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fingerprint", "observed_at", "expires_at", "session_id", "build_version", "build_sha256"],
                "properties": {
                  "fingerprint": { "$ref": "#/$defs/digest" },
                  "observed_at": { "type": ["string", "null"] },
                  "expires_at": { "type": ["string", "null"] },
                  "session_id": { "type": ["string", "null"] },
                  "build_version": { "type": ["string", "null"] },
                  "build_sha256": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
                }
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lazytrae.ai/schemas/active-loop.schema.json",
  "title": "Active Loop Schema",
  "description": "LazyTrae active-loop schema for long-horizon goal execution.",
  "type": "object",
  "required": ["version", "created_at", "updated_at", "brief_path", "goals_path", "ledger_path", "goals"],
  "properties": {
    "version": { "type": "integer", "description": "Schema version. Must be 1.", "minimum": 1, "maximum": 1 },
    "run_id": { "type": ["string", "null"], "description": "Unique run identifier for this loop execution; null while idle." },
    "loop_state": {
      "type": "string",
      "description": "Current loop state. One of 10 states from execution-loop.md.",
      "enum": ["idle", "initializing", "planning", "active", "verifying", "reviewing", "blocked", "paused", "complete", "cancelled"]
    },
    "loop_mode": {
      "type": "string",
      "description": "Loop mode: ultrawork (500 max iterations) or normal (100 max iterations).",
      "enum": ["ultrawork", "normal"]
    },
    "completion_promise": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "description": "The user's completion promise text from the original goal." }
      ]
    },
    "current_task_index": {
      "type": "integer",
      "description": "Index of the currently active task in the goals array.",
      "minimum": 0
    },
    "iteration": {
      "type": "integer",
      "description": "Current iteration number (one pass through steps 5-12 of the loop cycle).",
      "minimum": 0
    },
    "max_iterations": {
      "type": "integer",
      "description": "Maximum iterations: 500 for ultrawork and 100 for normal operation.",
      "minimum": 1,
      "maximum": 500
    },
    "retry_count": {
      "type": "integer",
      "description": "Number of verification retries for the current task. Max 3 before blocking.",
      "minimum": 0,
      "maximum": 3
    },
    "max_retries": {
      "type": "integer",
      "description": "Maximum verification retries before blocking a task: 3.",
      "minimum": 1,
      "maximum": 3
    },
    "reviewer_verdict": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "enum": ["APPROVE", "ITERATE", "REJECT"], "description": "Last Oracle reviewer verdict for the current task." }
      ]
    },
    "reviewer_issues": {
      "type": "array",
      "description": "Issues identified by the reviewer (for ITERATE/REJECT verdicts).",
      "items": { "type": "string" }
    },
    "started_at": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ],
      "description": "Timestamp when the loop started."
    },
    "completed_at": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ],
      "description": "Timestamp when the loop completed (aggregate completion)."
    },
    "cancelled_at": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ],
      "description": "Timestamp when the loop was cancelled."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "brief_path": { "type": ["string", "null"], "description": "Relative path to the brief file; null while idle." },
    "goals_path": { "type": ["string", "null"], "description": "Relative path to the goals JSON file; null while idle." },
    "ledger_path": { "type": ["string", "null"], "description": "Relative path to the ledger JSONL file; null while idle." },
    "codex_goal_mode": {
      "type": "string",
      "description": "Goal aggregation mode.",
      "enum": ["aggregate", "per_story"]
    },
    "codex_objective": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "description": "Aggregate objective text." }
      ]
    },
    "codex_objective_aliases": {
      "type": "array",
      "description": "Legacy objective aliases.",
      "items": { "type": "string" }
    },
    "active_goal_id": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "description": "ID of the currently active goal." }
      ]
    },
    "aggregate_completion": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/definitions/AggregateCompletion" }
      ]
    },
    "goals": {
      "type": "array",
      "description": "List of goals in this loop.",
      "items": { "$ref": "#/definitions/UlwLoopItem" }
    },
    "failure_attempts": {
      "type": "array",
      "description": "Repeated criterion failures keyed by goal, criterion, and normalized reason.",
      "items": { "$ref": "#/definitions/FailureAttempt" }
    },
    "review_blockers": {
      "type": "array",
      "description": "Review blockers created by repeated failures or explicit record-review-blockers calls.",
      "items": { "$ref": "#/definitions/ReviewBlocker" }
    },
    "final_quality_gate": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "description": "Last accepted final quality gate JSON." }
      ]
    },
    "checkpoints": {
      "type": "array",
      "description": "Checkpoint records for resumption.",
      "items": { "$ref": "#/definitions/Checkpoint" }
    },
    "metadata": {
      "type": "object",
      "description": "Metadata about the loop structure, including all enumerations from constants.ts.",
      "properties": {
        "description": { "type": "string" },
        "max_iterations": { "type": "integer" },
        "iteration_cap_source": { "type": "string" },
        "goal_statuses": { "type": "array", "items": { "type": "string" } },
        "loop_states": { "type": "array", "items": { "type": "string" } },
        "criterion_statuses": { "type": "array", "items": { "type": "string" } },
        "criterion_user_models": { "type": "array", "items": { "type": "string" } },
        "steering_mutation_kinds": { "type": "array", "items": { "type": "string" } },
        "ledger_event_kinds": { "type": "array", "items": { "type": "string" } },
        "loop_event_types": { "type": "array", "items": { "type": "string" } },
        "steering_source": { "type": "array", "items": { "type": "string" } },
        "manual_qa_surfaces": { "type": "array", "items": { "type": "string" } },
        "manual_qa_artifact_kinds": { "type": "array", "items": { "type": "string" } },
        "reviewer_verdicts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "adaptive": {
      "description": "Optional additive adaptive snapshot block. Single-writer rule: only the adaptive orchestrator writes this block. Existing v1.0.2 state files without this field continue to load. Additive extension; does not bump schema version.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approval",
            "blocker",
            "capabilityClasses",
            "capabilitySubstitutions",
            "currentStage",
            "decisionId",
            "escalationCount",
            "escalationHistory",
            "hostFingerprint",
            "mode",
            "nextAction",
            "reasons",
            "requestDigest",
            "responsibilities",
            "revisionFingerprint",
            "risk",
            "scopeFingerprint",
            "stages",
            "verificationLevel",
            "version"
          ],
          "properties": {
            "version": { "type": "integer", "const": 1 },
            "decisionId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
            "requestDigest": { "$ref": "#/definitions/AdaptiveSha256Digest" },
            "mode": { "$ref": "#/definitions/AdaptiveMode" },
            "stages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/AdaptiveStage" }
            },
            "currentStage": { "$ref": "#/definitions/AdaptiveStage" },
            "responsibilities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/AdaptiveResponsibility" }
            },
            "capabilityClasses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/AdaptiveCapabilityClass" }
            },
            "capabilitySubstitutions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["allowedSubstitutionClasses", "evidenceDowngrade", "explanation", "requiredClass"],
                "properties": {
                  "allowedSubstitutionClasses": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "$ref": "#/definitions/AdaptiveCapabilityClass" }
                  },
                  "evidenceDowngrade": {
                    "type": "string",
                    "enum": ["additional-verification-required", "none", "reduced-confidence"]
                  },
                  "explanation": { "$ref": "#/definitions/AdaptivePortableText" },
                  "requiredClass": { "$ref": "#/definitions/AdaptiveCapabilityClass" }
                }
              }
            },
            "approval": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requiredClasses", "status"],
              "properties": {
                "requiredClasses": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "$ref": "#/definitions/AdaptiveApprovalClass" }
                },
                "status": {
                  "type": "string",
                  "enum": ["denied", "granted", "not-required", "pending"]
                }
              },
              "allOf": [
                {
                  "if": { "properties": { "status": { "const": "not-required" } } },
                  "then": { "properties": { "requiredClasses": { "maxItems": 0 } } }
                },
                {
                  "if": { "properties": { "status": { "enum": ["denied", "granted", "pending"] } } },
                  "then": { "properties": { "requiredClasses": { "minItems": 1 } } }
                }
              ]
            },
            "escalationCount": { "type": "integer", "minimum": 0, "maximum": 2 },
            "escalationHistory": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fromMode", "sequence", "stageAdded", "toMode", "trigger"],
                "properties": {
                  "fromMode": { "$ref": "#/definitions/AdaptiveMode" },
                  "sequence": { "type": "integer", "minimum": 1, "maximum": 2 },
                  "stageAdded": {
                    "oneOf": [
                      { "$ref": "#/definitions/AdaptiveStage" },
                      { "type": "null" }
                    ]
                  },
                  "toMode": { "$ref": "#/definitions/AdaptiveMode" },
                  "trigger": {
                    "type": "string",
                    "enum": [
                      "broader-scope-revealed",
                      "capability-unavailable",
                      "new-risk-finding",
                      "user-goal-changed",
                      "verification-failure"
                    ]
                  }
                }
              }
            },
            "revisionFingerprint": {
              "type": "object",
              "additionalProperties": false,
              "required": ["digest", "status"],
              "properties": {
                "digest": {
                  "oneOf": [
                    { "$ref": "#/definitions/AdaptiveSha256Digest" },
                    { "type": "null" }
                  ]
                },
                "status": { "type": "string", "enum": ["available", "unavailable"] }
              },
              "allOf": [
                {
                  "if": { "properties": { "status": { "const": "available" } } },
                  "then": { "properties": { "digest": { "$ref": "#/definitions/AdaptiveSha256Digest" } } }
                },
                {
                  "if": { "properties": { "status": { "const": "unavailable" } } },
                  "then": { "properties": { "digest": { "type": "null" } } }
                }
              ]
            },
            "scopeFingerprint": { "$ref": "#/definitions/AdaptiveSha256Digest" },
            "hostFingerprint": { "$ref": "#/definitions/AdaptiveSha256Digest" },
            "risk": { "type": "string", "enum": ["high", "low", "material", "standard"] },
            "reasons": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/AdaptivePortableText" }
            },
            "blocker": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "attemptedApproaches",
                    "currentEvidence",
                    "nextRequiredDecision",
                    "reproducedFailure",
                    "unresolvedDecision"
                  ],
                  "properties": {
                    "attemptedApproaches": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": { "$ref": "#/definitions/AdaptivePortableText" }
                    },
                    "currentEvidence": { "$ref": "#/definitions/AdaptivePortableText" },
                    "nextRequiredDecision": { "$ref": "#/definitions/AdaptivePortableText" },
                    "reproducedFailure": { "$ref": "#/definitions/AdaptivePortableText" },
                    "unresolvedDecision": { "$ref": "#/definitions/AdaptivePortableText" }
                  }
                }
              ]
            },
            "nextAction": { "$ref": "#/definitions/AdaptivePortableText" },
            "verificationLevel": {
              "type": "string",
              "enum": ["independent", "live-surface", "standard", "targeted"]
            }
          },
          "allOf": [
            {
              "if": { "properties": { "currentStage": { "const": "continue" } } },
              "then": { "properties": { "stages": { "contains": { "const": "continue" } } } }
            },
            {
              "if": { "properties": { "currentStage": { "const": "debug" } } },
              "then": { "properties": { "stages": { "contains": { "const": "debug" } } } }
            },
            {
              "if": { "properties": { "currentStage": { "const": "implement" } } },
              "then": { "properties": { "stages": { "contains": { "const": "implement" } } } }
            },
            {
              "if": { "properties": { "currentStage": { "const": "plan" } } },
              "then": { "properties": { "stages": { "contains": { "const": "plan" } } } }
            },
            {
              "if": { "properties": { "currentStage": { "const": "review" } } },
              "then": { "properties": { "stages": { "contains": { "const": "review" } } } }
            },
            {
              "if": { "properties": { "currentStage": { "const": "understand" } } },
              "then": { "properties": { "stages": { "contains": { "const": "understand" } } } }
            },
            {
              "if": { "properties": { "currentStage": { "const": "verify" } } },
              "then": { "properties": { "stages": { "contains": { "const": "verify" } } } }
            },
            {
              "if": { "properties": { "escalationCount": { "const": 0 } } },
              "then": { "properties": { "escalationHistory": { "maxItems": 0 } } }
            },
            {
              "if": { "properties": { "escalationCount": { "const": 1 } } },
              "then": {
                "properties": {
                  "escalationHistory": {
                    "minItems": 1,
                    "maxItems": 1,
                    "items": [
                      { "properties": { "sequence": { "const": 1 } } }
                    ],
                    "additionalItems": false
                  }
                }
              }
            },
            {
              "if": { "properties": { "escalationCount": { "const": 2 } } },
              "then": {
                "properties": {
                  "escalationHistory": {
                    "minItems": 2,
                    "maxItems": 2,
                    "items": [
                      { "properties": { "sequence": { "const": 1 } } },
                      { "properties": { "sequence": { "const": 2 } } }
                    ],
                    "additionalItems": false
                  }
                }
              }
            }
          ]
        }
      ]
    }
  },
  "definitions": {
    "AdaptiveApprovalClass": {
      "type": "string",
      "enum": [
        "account-marketplace-or-publish-mutation",
        "browser-or-desktop-control",
        "credentials-auth-or-paid-service",
        "host-mcp-settings-mutation",
        "install-or-download",
        "persistent-capability",
        "remote-data-egress"
      ]
    },
    "AdaptiveCapabilityClass": {
      "type": "string",
      "enum": [
        "architecture-context",
        "documentation",
        "execution",
        "outcome-verification",
        "semantic-navigation",
        "structural-search",
        "task-state",
        "text-search"
      ]
    },
    "AdaptiveMode": {
      "type": "string",
      "enum": ["direct", "assisted", "planned", "orchestrated", "long-horizon"]
    },
    "AdaptivePortableText": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "runtimeResolution|host-native|package-lsp|package-cli|package-loop-store|lsp-bridge|/Users/|\\\\Users\\\\|\\.worktrees/|\\.trae/|\\.lazytrae/|(^|\\s)(src|lib|packages|tests?)/|provider[=:]|host[=:]"
      }
    },
    "AdaptiveResponsibility": {
      "type": "string",
      "enum": [
        "continuity",
        "debugging",
        "exploration",
        "implementation",
        "planning",
        "quality-review",
        "release-review",
        "security-review",
        "verification"
      ]
    },
    "AdaptiveSha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "AdaptiveStage": {
      "type": "string",
      "enum": ["continue", "debug", "implement", "plan", "review", "understand", "verify"]
    },
    "UlwLoopStatus": {
      "type": "string",
      "description": "Goal status enum from constants.ts: pending, in_progress, complete, failed, blocked, review_blocked, needs_user_decision.",
      "enum": ["pending", "in_progress", "complete", "failed", "blocked", "review_blocked", "needs_user_decision"]
    },
    "UlwLoopCriterionStatus": {
      "type": "string",
      "description": "Success criterion status enum from constants.ts: pending, pass, fail, blocked.",
      "enum": ["pending", "pass", "fail", "blocked"]
    },
    "UlwLoopSuccessCriterionUserModel": {
      "type": "string",
      "description": "Success criterion user model enum from constants.ts: happy, edge, regression, adversarial.",
      "enum": ["happy", "edge", "regression", "adversarial"]
    },
    "UlwLoopSteeringMutationKind": {
      "type": "string",
      "description": "Steering mutation kind enum from constants.ts. 7 kinds total.",
      "enum": ["add_subgoal", "split_subgoal", "reorder_pending", "revise_pending_wording", "revise_criterion", "annotate_ledger", "mark_blocked_superseded"]
    },
    "UlwLoopSteeringStatus": {
      "type": "string",
      "description": "Steering status enum from constants.ts: superseded, blocked.",
      "enum": ["superseded", "blocked"]
    },
    "LoopState": {
      "type": "string",
      "description": "Loop state enum. 10 states total.",
      "enum": ["idle", "initializing", "planning", "active", "verifying", "reviewing", "blocked", "paused", "complete", "cancelled"]
    },
    "ReviewerVerdict": {
      "type": "string",
      "description": "Oracle reviewer verdict: APPROVE, ITERATE, or REJECT.",
      "enum": ["APPROVE", "ITERATE", "REJECT"]
    },
    "SuccessCriterion": {
      "type": "object",
      "required": ["id", "scenario", "userModel", "expectedEvidence", "status"],
      "properties": {
        "id": { "type": "string", "description": "Unique criterion identifier." },
        "scenario": { "type": "string", "description": "Description of the test scenario." },
        "userModel": { "$ref": "#/definitions/UlwLoopSuccessCriterionUserModel" },
        "expectedEvidence": { "type": "string", "description": "What evidence is expected to pass this criterion." },
        "essential": { "type": "boolean", "description": "Whether this criterion is essential for completion." },
        "capturedEvidence": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "description": "Path or text of captured evidence." }
          ]
        },
        "status": { "$ref": "#/definitions/UlwLoopCriterionStatus" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string", "description": "Additional notes about this criterion." }
      }
    },
    "UlwLoopItem": {
      "type": "object",
      "required": ["id", "title", "objective", "status", "successCriteria", "attempt", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "description": "Unique goal identifier (usually Gxxx format)." },
        "title": { "type": "string", "description": "Short title of the goal." },
        "objective": { "type": "string", "description": "Detailed objective description." },
        "status": { "$ref": "#/definitions/UlwLoopStatus" },
        "successCriteria": {
          "type": "array",
          "description": "List of success criteria for this goal.",
          "items": { "$ref": "#/definitions/SuccessCriterion" }
        },
        "attempt": { "type": "integer", "description": "Number of attempts on this goal.", "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "failedAt": { "type": "string", "format": "date-time" },
        "reviewBlockedAt": { "type": "string", "format": "date-time" },
        "evidence": { "type": "string", "description": "Evidence for this goal." },
        "failureReason": { "type": "string", "description": "Reason for failure, if failed." },
        "steeringStatus": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/UlwLoopSteeringStatus" }
          ]
        },
        "supersededBy": { "type": "array", "items": { "type": "string" }, "description": "IDs of goals that supersede this goal." },
        "supersedes": { "type": "array", "items": { "type": "string" }, "description": "IDs of goals that this goal supersedes." },
        "blockedReason": { "type": "string", "description": "Reason for blocking, if blocked." },
        "blockerSignature": { "type": "string", "description": "Unique blocker signature for deduplication." },
        "blockerOccurrenceCount": { "type": "integer", "minimum": 0 },
        "requiredExternalDecision": { "type": "string", "description": "External decision required from user." },
        "nonRetriable": { "type": "boolean", "description": "Whether this failure/block is non-retriable." },
        "steeringEvidence": { "type": "string", "description": "Evidence for the steering mutation." },
        "steeringRationale": { "type": "string", "description": "Rationale for the steering mutation." }
      }
    },
    "AggregateCompletion": {
      "type": "object",
      "required": ["status", "completedAt", "evidence"],
      "properties": {
        "status": { "type": "string", "enum": ["complete"] },
        "completedAt": { "type": "string", "format": "date-time" },
        "evidence": { "type": "string", "description": "Path to completion evidence file." },
        "codexGoal": { "description": "Legacy Codex goal object." }
      }
    },
    "FailureAttempt": {
      "type": "object",
      "required": ["key", "goal_id", "criterion_id", "reason", "count"],
      "properties": {
        "key": { "type": "string" },
        "goal_id": { "type": "string" },
        "criterion_id": { "type": "string" },
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "ReviewBlocker": {
      "type": "object",
      "required": ["goal_id", "created_at"],
      "properties": {
        "goal_id": { "type": "string" },
        "criterion_id": { "type": "string" },
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "objective": { "type": "string" },
        "evidence": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "Checkpoint": {
      "type": "object",
      "required": ["id", "iteration", "created_at", "goal_id", "status", "summary"],
      "properties": {
        "id": { "type": "string", "description": "Unique checkpoint identifier." },
        "iteration": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "goal_id": { "type": "string", "description": "Goal that was active at checkpoint." },
        "status": {
          "type": "string",
          "description": "Goal status at checkpoint.",
          "enum": ["pending", "in_progress", "checkpointed", "complete", "blocked"]
        },
        "summary": { "type": "string", "description": "Summary of progress at this checkpoint." },
        "evidence_paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Evidence paths captured at this checkpoint."
        }
      }
    }
  }
}

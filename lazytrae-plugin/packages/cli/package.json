{
  "name": "lazytrae-ai",
  "version": "1.2.1",
  "description": "LazyTrae CLI installer and doctor — Trae-native workflows with MCP support",
  "main": "src/index.js",
  "bin": {
    "lazytrae-ai": "bin/lazytrae.js",
    "lazytrae": "bin/lazytrae.js"
  },
  "scripts": {
    "test": "npm run test:package",
    "test:package": "node ./tools/test-fixture-runner.js test/packaged-self-verification.test.js test/work-profile.test.js test/work-profile-worktree.test.js test/work.test.js test/work-mcp-declaration.test.js test/mcp-declaration-safety.test.js",
    "test:source": "node ./tools/test-fixture-runner.js --exclude=test/packaged-self-verification.test.js --exclude=test/work-profile.test.js --exclude=test/work-profile-worktree.test.js --exclude=test/work.test.js --exclude=test/work-mcp-declaration.test.js --exclude=test/mcp-declaration-safety.test.js",
    "test:all": "npm run test:source && npm run test:package",
    "test:publication": "node ./tools/test-fixture-runner.js publication/documentation-publication.js"
  },
  "keywords": [
    "lazytrae",
    "ultrawork",
    "ulw-loop",
    "workflow",
    "ai",
    "trae"
  ],
  "author": "LazyTrae Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/elvinzhao10/LazyTrae.git"
  },
  "bugs": {
    "url": "https://github.com/elvinzhao10/LazyTrae/issues"
  },
  "homepage": "https://github.com/elvinzhao10/LazyTrae#readme",
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "3.0.1",
    "fast-uri": "4.1.4"
  },
  "bundledDependencies": [
    "ajv",
    "ajv-formats",
    "fast-uri"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lazytrae.ai/schemas/active-loop.schema.json",
  "title": "Active Loop Schema",
  "description": "LazyTrae Active Loop schema for long-horizon goal execution. Mirrors LazyCodex UlwLoopPlan from domain-types.ts.",
  "type": "object",
  "required": ["version", "created_at", "updated_at", "brief_path", "goals_path", "ledger_path", "goals"],
  "properties": {
    "version": { "type": "integer", "description": "Schema version. Must be 1.", "minimum": 1, "maximum": 1 },
    "run_id": { "type": "string", "description": "Unique run identifier for this loop execution." },
    "loop_state": {
      "type": "string",
      "description": "Current loop state. One of 10 states from execution-loop.md.",
      "enum": ["idle", "initializing", "planning", "active", "verifying", "reviewing", "blocked", "paused", "complete", "cancelled"]
    },
    "loop_mode": {
      "type": "string",
      "description": "Loop mode: ultrawork (500 max iterations) or normal (100 max iterations).",
      "enum": ["ultrawork", "normal"]
    },
    "completion_promise": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "description": "The user's completion promise text from the original goal." }
      ]
    },
    "current_task_index": {
      "type": "integer",
      "description": "Index of the currently active task in the goals array.",
      "minimum": 0
    },
    "iteration": {
      "type": "integer",
      "description": "Current iteration number (one pass through steps 5-12 of the loop cycle).",
      "minimum": 0
    },
    "max_iterations": {
      "type": "integer",
      "description": "Maximum iterations. 500 for ultrawork, 100 for normal. From lazycodex constants.ts.",
      "minimum": 1,
      "maximum": 500
    },
    "retry_count": {
      "type": "integer",
      "description": "Number of verification retries for the current task. Max 3 before blocking.",
      "minimum": 0,
      "maximum": 3
    },
    "max_retries": {
      "type": "integer",
      "description": "Maximum verification retries before blocking a task. Always 3 (from LazyCodex).",
      "minimum": 1,
      "maximum": 3
    },
    "reviewer_verdict": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "enum": ["APPROVE", "ITERATE", "REJECT"], "description": "Last Oracle reviewer verdict for the current task." }
      ]
    },
    "reviewer_issues": {
      "type": "array",
      "description": "Issues identified by the reviewer (for ITERATE/REJECT verdicts).",
      "items": { "type": "string" }
    },
    "started_at": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ],
      "description": "Timestamp when the loop started."
    },
    "completed_at": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ],
      "description": "Timestamp when the loop completed (aggregate completion)."
    },
    "cancelled_at": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "format": "date-time" }
      ],
      "description": "Timestamp when the loop was cancelled."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "brief_path": { "type": "string", "description": "Relative path to the brief file." },
    "goals_path": { "type": "string", "description": "Relative path to the goals JSON file." },
    "ledger_path": { "type": "string", "description": "Relative path to the ledger JSONL file." },
    "codex_goal_mode": {
      "type": "string",
      "description": "Goal aggregation mode.",
      "enum": ["aggregate", "per_story"]
    },
    "codex_objective": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "description": "Aggregate objective text." }
      ]
    },
    "codex_objective_aliases": {
      "type": "array",
      "description": "Legacy objective aliases.",
      "items": { "type": "string" }
    },
    "active_goal_id": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "description": "ID of the currently active goal." }
      ]
    },
    "aggregate_completion": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/definitions/AggregateCompletion" }
      ]
    },
    "goals": {
      "type": "array",
      "description": "List of goals in this loop.",
      "items": { "$ref": "#/definitions/UlwLoopItem" }
    },
    "failure_attempts": {
      "type": "array",
      "description": "Repeated criterion failures keyed by goal, criterion, and normalized reason.",
      "items": { "$ref": "#/definitions/FailureAttempt" }
    },
    "review_blockers": {
      "type": "array",
      "description": "Review blockers created by repeated failures or explicit record-review-blockers calls.",
      "items": { "$ref": "#/definitions/ReviewBlocker" }
    },
    "final_quality_gate": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "description": "Last accepted final quality gate JSON." }
      ]
    },
    "checkpoints": {
      "type": "array",
      "description": "Checkpoint records for resumption.",
      "items": { "$ref": "#/definitions/Checkpoint" }
    },
    "metadata": {
      "type": "object",
      "description": "Metadata about the loop structure, including all enumerations from constants.ts.",
      "properties": {
        "description": { "type": "string" },
        "max_iterations": { "type": "integer" },
        "iteration_cap_source": { "type": "string" },
        "goal_statuses": { "type": "array", "items": { "type": "string" } },
        "loop_states": { "type": "array", "items": { "type": "string" } },
        "criterion_statuses": { "type": "array", "items": { "type": "string" } },
        "criterion_user_models": { "type": "array", "items": { "type": "string" } },
        "steering_mutation_kinds": { "type": "array", "items": { "type": "string" } },
        "ledger_event_kinds": { "type": "array", "items": { "type": "string" } },
        "loop_event_types": { "type": "array", "items": { "type": "string" } },
        "steering_source": { "type": "array", "items": { "type": "string" } },
        "manual_qa_surfaces": { "type": "array", "items": { "type": "string" } },
        "manual_qa_artifact_kinds": { "type": "array", "items": { "type": "string" } },
        "reviewer_verdicts": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "definitions": {
    "UlwLoopStatus": {
      "type": "string",
      "description": "Goal status enum from constants.ts: pending, in_progress, complete, failed, blocked, review_blocked, needs_user_decision.",
      "enum": ["pending", "in_progress", "complete", "failed", "blocked", "review_blocked", "needs_user_decision"]
    },
    "UlwLoopCriterionStatus": {
      "type": "string",
      "description": "Success criterion status enum from constants.ts: pending, pass, fail, blocked.",
      "enum": ["pending", "pass", "fail", "blocked"]
    },
    "UlwLoopSuccessCriterionUserModel": {
      "type": "string",
      "description": "Success criterion user model enum from constants.ts: happy, edge, regression, adversarial.",
      "enum": ["happy", "edge", "regression", "adversarial"]
    },
    "UlwLoopSteeringMutationKind": {
      "type": "string",
      "description": "Steering mutation kind enum from constants.ts. 7 kinds total.",
      "enum": ["add_subgoal", "split_subgoal", "reorder_pending", "revise_pending_wording", "revise_criterion", "annotate_ledger", "mark_blocked_superseded"]
    },
    "UlwLoopSteeringStatus": {
      "type": "string",
      "description": "Steering status enum from constants.ts: superseded, blocked.",
      "enum": ["superseded", "blocked"]
    },
    "LoopState": {
      "type": "string",
      "description": "Loop state enum. 10 states total.",
      "enum": ["idle", "initializing", "planning", "active", "verifying", "reviewing", "blocked", "paused", "complete", "cancelled"]
    },
    "ReviewerVerdict": {
      "type": "string",
      "description": "Oracle reviewer verdict: APPROVE, ITERATE, or REJECT.",
      "enum": ["APPROVE", "ITERATE", "REJECT"]
    },
    "SuccessCriterion": {
      "type": "object",
      "required": ["id", "scenario", "userModel", "expectedEvidence", "status"],
      "properties": {
        "id": { "type": "string", "description": "Unique criterion identifier." },
        "scenario": { "type": "string", "description": "Description of the test scenario." },
        "userModel": { "$ref": "#/definitions/UlwLoopSuccessCriterionUserModel" },
        "expectedEvidence": { "type": "string", "description": "What evidence is expected to pass this criterion." },
        "essential": { "type": "boolean", "description": "Whether this criterion is essential for completion." },
        "capturedEvidence": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "description": "Path or text of captured evidence." }
          ]
        },
        "status": { "$ref": "#/definitions/UlwLoopCriterionStatus" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string", "description": "Additional notes about this criterion." }
      }
    },
    "UlwLoopItem": {
      "type": "object",
      "required": ["id", "title", "objective", "status", "successCriteria", "attempt", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "description": "Unique goal identifier (usually Gxxx format)." },
        "title": { "type": "string", "description": "Short title of the goal." },
        "objective": { "type": "string", "description": "Detailed objective description." },
        "status": { "$ref": "#/definitions/UlwLoopStatus" },
        "successCriteria": {
          "type": "array",
          "description": "List of success criteria for this goal.",
          "items": { "$ref": "#/definitions/SuccessCriterion" }
        },
        "attempt": { "type": "integer", "description": "Number of attempts on this goal.", "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "failedAt": { "type": "string", "format": "date-time" },
        "reviewBlockedAt": { "type": "string", "format": "date-time" },
        "evidence": { "type": "string", "description": "Evidence for this goal." },
        "failureReason": { "type": "string", "description": "Reason for failure, if failed." },
        "steeringStatus": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/UlwLoopSteeringStatus" }
          ]
        },
        "supersededBy": { "type": "array", "items": { "type": "string" }, "description": "IDs of goals that supersede this goal." },
        "supersedes": { "type": "array", "items": { "type": "string" }, "description": "IDs of goals that this goal supersedes." },
        "blockedReason": { "type": "string", "description": "Reason for blocking, if blocked." },
        "blockerSignature": { "type": "string", "description": "Unique blocker signature for deduplication." },
        "blockerOccurrenceCount": { "type": "integer", "minimum": 0 },
        "requiredExternalDecision": { "type": "string", "description": "External decision required from user." },
        "nonRetriable": { "type": "boolean", "description": "Whether this failure/block is non-retriable." },
        "steeringEvidence": { "type": "string", "description": "Evidence for the steering mutation." },
        "steeringRationale": { "type": "string", "description": "Rationale for the steering mutation." }
      }
    },
    "AggregateCompletion": {
      "type": "object",
      "required": ["status", "completedAt", "evidence"],
      "properties": {
        "status": { "type": "string", "enum": ["complete"] },
        "completedAt": { "type": "string", "format": "date-time" },
        "evidence": { "type": "string", "description": "Path to completion evidence file." },
        "codexGoal": { "description": "Legacy Codex goal object." }
      }
    },
    "FailureAttempt": {
      "type": "object",
      "required": ["key", "goal_id", "criterion_id", "reason", "count"],
      "properties": {
        "key": { "type": "string" },
        "goal_id": { "type": "string" },
        "criterion_id": { "type": "string" },
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "ReviewBlocker": {
      "type": "object",
      "required": ["goal_id", "created_at"],
      "properties": {
        "goal_id": { "type": "string" },
        "criterion_id": { "type": "string" },
        "reason": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "objective": { "type": "string" },
        "evidence": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "Checkpoint": {
      "type": "object",
      "required": ["id", "iteration", "created_at", "goal_id", "status", "summary"],
      "properties": {
        "id": { "type": "string", "description": "Unique checkpoint identifier." },
        "iteration": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "goal_id": { "type": "string", "description": "Goal that was active at checkpoint." },
        "status": {
          "type": "string",
          "description": "Goal status at checkpoint.",
          "enum": ["pending", "in_progress", "checkpointed", "complete", "blocked"]
        },
        "summary": { "type": "string", "description": "Summary of progress at this checkpoint." },
        "evidence_paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Evidence paths captured at this checkpoint."
        }
      }
    }
  }
}

.lazytrae/logs/
.lazytrae/evidence/

# OmO compatibility state (keep directory structure, ignore live state)
.omo/boulder.json
.omo/ulw-loop/*/goals.json
.omo/ulw-loop/*/evidence.jsonl
.omo/ulw-loop/*/checkpoints.jsonl
lazycodex/
